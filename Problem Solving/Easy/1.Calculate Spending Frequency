/*
You have 500 Taka. Each time, you spend 75 Taka.
-How many times can you spend 75 Taka?
-How much money will remain after spending as many times as possible?
-Write a program to calculate and display the results.
*/

let totalMoney = 500;
let spendingAmount = 75;

let timesSpent = Math.floor(totalMoney / spendingAmount);
let remainingMoney = totalMoney % spendingAmount;

console.log("You can spend 75 Taka " + timesSpent + " times.");
console.log("Remaining money after spending: " + remainingMoney + " Taka.");
